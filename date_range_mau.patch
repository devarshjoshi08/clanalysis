+.cov-month-label { font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
+.cov-grid { display: grid; grid-template-columns: repeat(16, 20px); gap: 3px; }
+.cov-cell {
+  display: inline-block; width: 20px; height: 20px; border-radius: 3px;
