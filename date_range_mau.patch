+.dlg { width: min(520px, 92vw); }
+.dlg-body { padding: 18px 20px 8px 20px; font-size: 13px; background: var(--surface-2); overflow-y: auto; }
+.dlg-body p { margin: 0 0 10px 0; }
+.dlg-body ul { margin: 6px 0 10px 0; padding-left: 20px; }
+.dlg-body input { width: 100%; margin-top: 6px; }
+.dlg-msg { padding: 0 20px 10px 20px; font-size: 12px; min-height: 8px; background: var(--surface-2); }
+.dlg-msg.error { color: var(--danger); }
+.dlg-msg.info { color: var(--text-muted); }
+
+/* Publishing settings dialog */
+.field.stacked { display: flex; flex-direction: column; align-items: stretch; gap: 0; margin: 0 0 10px 0; font-size: 12px; }
+.field.stacked input { font-weight: 400; }
+.cfg-box { margin-top: 14px; padding: 10px 12px; border: 1px dashed var(--border); border-radius: 4px; }
+.cfg-box.ok { border-style: solid; border-color: var(--success); }
+.cfg-box p { margin: 0 0 6px 0; font-size: 12px; color: var(--text-muted); }
+.cfg-box.ok p { color: var(--success); margin: 0; }
+.cfg-box.ok .cfg-text { display: none; }
+.cfg-text { margin: 0; padding: 8px 10px; background: var(--surface-3); border-radius: 4px; font-size: 12px; user-select: all; white-space: pre-wrap; }
+#addSetup { margin-bottom: 12px; }
+.admin-on .link-btn { margin-left: 10px; }
+
+@media (max-width: 640px) {
+  .admin-bar { margin-left: 0; width: 100%; }
+  .cov-grid { grid-template-columns: repeat(10, 20px); }
+}
+
 /* ===== Responsive ===== */
 @media (max-width: 640px) {
   .content { padding: 20px 16px; }
