+  color-scheme: dark;
+}
+input[type="date"]:focus, input[type="password"]:focus, input[type="text"]:focus { outline: 2px solid var(--primary-light); outline-offset: 1px; }
+.repeat-box { border-left: 3px solid var(--border); padding: 4px 0 0 14px; margin-bottom: 8px; }
+.presets { display: inline-flex; gap: 6px; flex-wrap: wrap; }
+.btn-chip {
+  background: var(--surface-3); color: var(--text); border: 1px solid var(--border);
+  border-radius: 12px; padding: 4px 12px; font-size: 12px; cursor: pointer;
+}
+.btn-chip:hover:not(:disabled) { background: var(--border); }
+.btn-chip:disabled { opacity: 0.4; cursor: not-allowed; }
