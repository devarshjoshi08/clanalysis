+.add-result { margin-top: 12px; font-size: 12px; }
+.result-table { border-collapse: collapse; margin: 8px 0; min-width: 320px; }
+.result-table th, .result-table td { border: 1px solid var(--border); padding: 5px 12px; text-align: right; }
