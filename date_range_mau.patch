+.muted { color: var(--text-muted); }
+.store-label {
+  background: var(--surface-3);
+  border-left: 4px solid var(--warning);
+  border-radius: 4px;
+  padding: 10px 14px;
+  font-size: 13px;
+  font-weight: 600;
+}
+.store-label.ok { border-left-color: var(--success); }
+.store-label.warn { border-left-color: var(--warning); }
