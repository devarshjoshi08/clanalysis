+  }
+
+  /* ---------- read a range ---------- */
+  /** Earliest MAU / login timestamp per student across the stored days in [fromKey, toKey]. */
+  async function loadActivityForRange(fromKey, toKey, manifestOpt) {
+    const a0 = requireAdapter();
