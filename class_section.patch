+/**
+ * Accepted header spellings per roster column, lower-cased and stripped of
+ * spaces/underscores/hyphens. The template has used 'class', 'Class',
+ * 'className', 'Grade' and 'Standard' across versions, so match all of them
+ * instead of pinning one name.
+ */
+const ROSTER_ALIASES = {
+  'class':   ['class', 'classname', 'grade', 'standard', 'studentclass', 'classgrade'],
+  'section': ['section', 'sectionname', 'sec', 'division', 'studentsection']
+};
+
+/** Normalize a header for alias matching: lower-case, drop spaces/_/-/. */
+function normHeader(h) {
+  return String(h == null ? '' : h).trim().toLowerCase().replace(/[\s_\-.]+/g, '');
+}
+
+/**
+ * Index of `col` in `header`. Exact match wins; otherwise falls back to the
+ * alias table (case- and separator-insensitive). Returns -1 when absent.
+ */
+function findRosterCol(header, col) {
+  const exact = header.indexOf(col);
+  if (exact >= 0) return exact;
+  const aliases = ROSTER_ALIASES[col];
+  if (!aliases) return -1;
+  const normed = header.map(normHeader);
+  for (const a of aliases) {
+    const i = normed.indexOf(a);
+    if (i >= 0) return i;
+  }
+  return -1;
+}
