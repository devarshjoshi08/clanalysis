+async function buildAdobeWorkbook(rawRows, summaries, mauDist) {
+  const wb = new ExcelJS.Workbook();
+  const rawHeaderFill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFA21E01' } };
